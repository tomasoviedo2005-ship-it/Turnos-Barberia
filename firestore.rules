rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /bookings/{bookingId} {
      // La web necesita leer los horarios para mostrar cuáles están ocupados.
      // Los datos personales solo se muestran dentro del panel del administrador.
      allow read: if signedIn();
      // Cualquier visitante autenticado (la web inicia sesión anónima) puede
      // crear una reserva, pero no puede modificar ni borrar reservas.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'time', 'clientName', 'service', 'createdAt'])
        && request.resource.data.day is string
        && request.resource.data.time is string
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.clientName.size() <= 70
        && request.resource.data.service is string
        && request.resource.data.service.size() <= 80
        && request.resource.data.createdAt is int;
      allow update, delete: if isAdmin();
    }

    // Este documento lo creás manualmente desde Firebase Console para el UID
    // de la cuenta administradora. Ningún cliente puede crearlo o modificarlo.
    match /admins/{adminUid} {
      allow read: if signedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }
  }
}
